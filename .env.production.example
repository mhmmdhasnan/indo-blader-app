APP_NAME="Indo Blader"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-kamu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST=db karena di docker-compose.yml service MySQL-nya bernama "db" —
# container saling kontak lewat nama service, bukan IP/localhost.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_indoblader
DB_USERNAME=blader_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Sama seperti DB_HOST: REVERB_HOST=reverb karena service websocket-nya di
# docker-compose.yml bernama "reverb", dan port 8080 itu port INTERNAL
# container (lihat command reverb:start di docker-compose.yml) — bukan 8090.
# 8090 cuma dipakai `composer dev` pas develop lokal di luar Docker. Kalau
# REVERB_HOST/PORT ini ketinggalan "localhost"/"8090" bawaan .env.example,
# app container gagal push event ke Reverb (nyambung ke dirinya sendiri,
# bukan ke container reverb) dan /live gak akan pernah dapat update live.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# VITE_REVERB_* sengaja dibiarkan kosong/tidak diisi di production: build
# frontend jalan di stage Docker terpisah yang tidak punya akses ke .env
# (lihat .dockerignore), jadi bundle JS otomatis fallback ke
# window.location.hostname/port lewat proxy nginx /app/ — bekerja sama
# persis baik diakses lewat IP LAN maupun domain Cloudflare Tunnel nanti,
# tanpa perlu rebuild. Jangan diisi manual, nanti malah override fallback-nya.

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@domain-kamu.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
